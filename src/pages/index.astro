---
import Layout from '../layouts/Layout.astro';
import BentoTheme from '../components/themes/bento/BentoTheme.astro';
import CraftTheme from '../components/themes/craft/CraftTheme.astro';
import MinimalTheme from '../components/themes/minimal/MinimalTheme.astro';
import ModernTheme from '../components/themes/modern/ModernTheme.astro';
import ParallaxTheme from '../components/themes/parallax/ParallaxTheme.astro';
import { portfolioData } from '../data/portfolio';
import { siteThemeConfig } from '../config/theme';

const { profile } = portfolioData;
const activeTheme = siteThemeConfig.activeTheme;
---

<Layout
  title={`${profile.name} | ${profile.headline}`}
  description={profile.shortSummary}
  currentVariant={activeTheme}
>
  {activeTheme === 'bento' ? (
    <BentoTheme />
  ) : activeTheme === 'craft' ? (
    <CraftTheme />
  ) : activeTheme === 'modern' ? (
    <ModernTheme />
  ) : activeTheme === 'parallax' ? (
    <ParallaxTheme />
  ) : (
    <MinimalTheme />
  )}
</Layout>
