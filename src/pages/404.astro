---
import Layout from '../layouts/Layout.astro';
import { portfolioData } from '../data/portfolio';
import { getAssetUrl } from '../utils/url';

const { profile } = portfolioData;
---

<Layout
  title={`Page Not Found | ${profile.name}`}
  description="The requested page could not be found."
>
  <div class="min-h-[70vh] flex items-center justify-center px-4 sm:px-6 lg:px-8 py-24">
    <div class="max-w-md w-full text-center">
      <div class="inline-flex h-16 w-16 items-center justify-center rounded-2xl bg-zinc-100 dark:bg-zinc-800 text-sky-600 dark:text-sky-400 font-mono text-2xl font-bold mb-6 border border-zinc-200 dark:border-zinc-700">
        404
      </div>
      <h1 class="text-3xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">
        Page Not Found
      </h1>
      <p class="mt-3 text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
        The page you are looking for doesn’t exist or has been moved. You can return to the portfolio homepage or jump directly to the application showcase.
      </p>

      <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3">
        <a
          href={getAssetUrl('/')}
          class="w-full sm:w-auto inline-flex items-center justify-center rounded-lg bg-zinc-900 text-white dark:bg-zinc-100 dark:text-zinc-900 px-5 py-2.5 text-sm font-semibold hover:bg-zinc-800 dark:hover:bg-white transition-colors"
        >
          Return to Homepage
        </a>
        <a
          href={getAssetUrl('/#work')}
          class="w-full sm:w-auto inline-flex items-center justify-center rounded-lg border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-900 px-5 py-2.5 text-sm font-semibold text-zinc-800 dark:text-zinc-200 hover:border-sky-500 hover:text-sky-600 dark:hover:text-sky-400 transition-colors"
        >
          Explore Applications
        </a>
      </div>
    </div>
  </div>
</Layout>
