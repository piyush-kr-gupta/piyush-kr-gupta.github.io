---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import DevVersionToolbar from '../components/DevVersionToolbar.astro';
import { portfolioData } from '../data/portfolio';
import { getAssetUrl } from '../utils/url';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  currentVariant?: string;
}

const { profile } = portfolioData;

const {
  title = `${profile.name} | ${profile.headline}`,
  description = profile.shortSummary,
  canonicalUrl = Astro.url.href,
  currentVariant,
} = Astro.props;

// Schema.org Structured Data
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.headline,
  description: profile.shortSummary,
  url: Astro.site ? new URL(Astro.url.pathname, Astro.site).href : canonicalUrl,
  sameAs: [portfolioData.contact.linkedin, portfolioData.contact.github].filter(Boolean),
  knowsAbout: [
    'Android Development',
    'Kotlin',
    'Flutter',
    'Dart',
    'Jetpack Compose',
    'Clean Architecture',
    'MVVM',
    'BLoC',
    'Mobile System Design',
  ],
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href={getAssetUrl('/favicon.svg')} />
    <link rel="icon" href={getAssetUrl('/favicon.ico')} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={`${profile.name} Portfolio`} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Color Scheme & Theme Meta -->
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#fafafa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#09090b" media="(prefers-color-scheme: dark)" />

    <!-- JSON-LD Structured Data for Search Engines -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Immediate Theme Initialization Script (Defaults to Light theme, respects explicit dark preference) -->
    <script is:inline>
      (function () {
        try {
          const stored = localStorage.getItem('theme');
          if (stored === 'dark') {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        } catch (_) {}
      })();
    </script>
  </head>
  <body class="min-h-screen bg-zinc-50 text-zinc-900 antialiased selection:bg-sky-500/25 dark:bg-zinc-950 dark:text-zinc-100 transition-colors">
    <!-- Accessible Skip to Content Link -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:rounded-lg focus:bg-sky-600 focus:px-4 focus:py-2.5 focus:text-sm focus:font-semibold focus:text-white focus:shadow-lg focus:outline-none"
    >
      Skip to main content
    </a>

    <!-- Top Navigation Header -->
    <Navbar />

    <!-- Main Content Landmark -->
    <main id="main-content" class="flex-1">
      <slot />
    </main>

    <!-- Footer Landmark -->
    <Footer />

    <!-- Dev-only preview toolbar (stripped from production builds) -->
    <DevVersionToolbar currentVariant={currentVariant} />
  </body>
</html>
