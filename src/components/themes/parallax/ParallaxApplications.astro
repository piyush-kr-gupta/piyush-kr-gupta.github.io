---
import { portfolioData, getUniqueDomains } from '../../../data/portfolio';
import { getAssetUrl } from '../../../utils/url';

const { applications } = portfolioData;
const uniqueDomains = getUniqueDomains(applications);
---

<section id="work" class="py-16 md:py-24 border-b border-zinc-200/80 dark:border-zinc-800/80 scroll-mt-16">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl mb-10">
      <div class="inline-flex items-center gap-2 rounded-md bg-purple-50 dark:bg-purple-950/60 px-2.5 py-1 text-xs font-semibold text-purple-700 dark:text-purple-300 border border-purple-200/80 dark:border-purple-800/60 mb-3">
        Spatial 3D Applications Showcase
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-zinc-900 dark:text-zinc-50">
        Production Engineering Portfolio
      </h2>
      <p class="mt-3 text-base text-zinc-600 dark:text-zinc-400 leading-relaxed">
        Interactive project cards featuring real-time perspective tilt. Hover over any card to experience dynamic 3D depth.
      </p>
    </div>

    <!-- Filter Controls -->
    <div class="mb-10 rounded-2xl border border-zinc-200/90 dark:border-zinc-800 bg-white/70 dark:bg-zinc-900/70 backdrop-blur-md p-5 shadow-sm">
      <div class="flex flex-col sm:flex-row gap-4 items-stretch sm:items-center justify-between">
        
        <!-- Search Input -->
        <div class="relative flex-1 max-w-md">
          <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5 text-zinc-400">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
          <input
            id="parallax-search-input"
            type="search"
            placeholder="Search applications..."
            class="w-full rounded-xl border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-950 pl-10 pr-9 py-2 text-sm text-zinc-900 dark:text-zinc-100 placeholder-zinc-400 focus:border-purple-500 focus:ring-2 focus:ring-purple-500/20 focus:outline-none transition-all"
            aria-label="Search applications"
          />
        </div>

        <!-- Filter Selects -->
        <div class="flex flex-wrap items-center gap-3">
          <div class="flex items-center gap-2">
            <label for="parallax-domain-filter" class="text-xs font-medium text-zinc-500 dark:text-zinc-400">Domain:</label>
            <select
              id="parallax-domain-filter"
              class="rounded-xl border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-900 px-3 py-2 text-xs sm:text-sm font-medium text-zinc-800 dark:text-zinc-200 focus:border-purple-500 focus:outline-none"
            >
              <option value="all">All Domains ({applications.length})</option>
              {uniqueDomains.map((d) => (
                <option value={d}>{d}</option>
              ))}
            </select>
          </div>

          <div class="flex items-center gap-2">
            <label for="parallax-model-filter" class="text-xs font-medium text-zinc-500 dark:text-zinc-400">Model:</label>
            <select
              id="parallax-model-filter"
              class="rounded-xl border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-900 px-3 py-2 text-xs sm:text-sm font-medium text-zinc-800 dark:text-zinc-200 focus:border-purple-500 focus:outline-none"
            >
              <option value="all">All</option>
              <option value="B2C">B2C</option>
              <option value="B2B">B2B</option>
            </select>
          </div>

          <button
            id="parallax-reset-btn"
            type="button"
            class="hidden items-center gap-1.5 rounded-lg border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-800 px-3 py-2 text-xs font-medium text-zinc-700 dark:text-zinc-300 hover:border-purple-500 hover:text-purple-600 transition-colors"
          >
            Reset
          </button>
        </div>
      </div>

      <div class="mt-4 pt-3 border-t border-zinc-200/70 dark:border-zinc-800/70 flex items-center justify-between text-xs text-zinc-500">
        <span id="parallax-results-count">Showing {applications.length} of {applications.length} applications</span>
      </div>
    </div>

    <!-- Parallax 3D Perspective Grid -->
    <div id="parallax-apps-grid" class="grid grid-cols-1 md:grid-cols-2 gap-8 [perspective:1000px]">
      {applications.map((app) => (
        <div class="tilt-wrapper will-change-transform">
          <article
            class="parallax-app-card group h-full flex flex-col justify-between rounded-2xl border border-zinc-200/90 dark:border-zinc-800 bg-white/90 dark:bg-zinc-900/90 backdrop-blur-md p-6 shadow-md hover:shadow-2xl hover:border-purple-500/50 transition-all duration-200 ease-out"
            data-app-id={app.id}
            data-name={app.name.toLowerCase()}
            data-domain={app.domain}
            data-model={app.businessModel}
            data-tech={app.technologies.join(' ').toLowerCase()}
          >
            <div>
              <!-- Header -->
              <div class="flex items-start justify-between gap-4 mb-4">
                <div class="flex items-center gap-3.5">
                  {app.iconPath ? (
                    <div class="card-icon relative h-13 w-13 shrink-0 overflow-hidden rounded-2xl border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-800 p-0.5 shadow-md transition-transform duration-300 group-hover:scale-110">
                      <img
                        src={getAssetUrl(app.iconPath)}
                        alt={`${app.name} icon`}
                        width="52"
                        height="52"
                        loading="lazy"
                        decoding="async"
                        class="h-full w-full object-cover rounded-[14px]"
                      />
                    </div>
                  ) : (
                    <div class="flex h-13 w-13 shrink-0 items-center justify-center rounded-2xl bg-zinc-100 dark:bg-zinc-800 font-bold text-sm tracking-tight text-zinc-800 dark:text-zinc-200 border border-zinc-200 dark:border-zinc-700 shadow-md">
                      {app.initials}
                    </div>
                  )}
                  <div>
                    <h3 class="text-lg font-bold text-zinc-900 dark:text-zinc-100 group-hover:text-purple-600 dark:group-hover:text-purple-400 transition-colors">
                      {app.name}
                    </h3>
                    {app.company && (
                      <p class="text-xs text-zinc-500 dark:text-zinc-400 font-medium">
                        {app.company}
                      </p>
                    )}
                  </div>
                </div>

                <div class="flex flex-col items-end gap-1.5 shrink-0">
                  <span class="inline-flex items-center rounded-lg bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 px-2.5 py-0.5 text-xs font-semibold text-zinc-700 dark:text-zinc-300">
                    {app.domain}
                  </span>
                  {app.businessModel !== 'Unspecified' && (
                    <span class="inline-flex items-center rounded-lg bg-purple-50 dark:bg-purple-950/60 border border-purple-200 dark:border-purple-800 px-2.5 py-0.5 text-[11px] font-bold text-purple-700 dark:text-purple-300">
                      {app.businessModel}
                    </span>
                  )}
                  {app.downloads && (
                    <span class="inline-flex items-center rounded-lg bg-emerald-50 dark:bg-emerald-950/60 border border-emerald-200 dark:border-emerald-800 px-2.5 py-0.5 text-[11px] font-bold text-emerald-700 dark:text-emerald-300">
                      {app.downloads}
                    </span>
                  )}
                </div>
              </div>

              <!-- Description -->
              <p class="text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed mb-4">
                {app.description}
              </p>

              <!-- Highlights -->
              {app.highlights && app.highlights.length > 0 && (
                <div class="mb-5 space-y-2">
                  <p class="text-xs font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400">
                    Engineering Highlights
                  </p>
                  <ul class="space-y-1.5 text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed">
                    {app.highlights.map((highlight) => (
                      <li class="flex items-start gap-2">
                        <span class="text-purple-500 dark:text-purple-400 mt-0.5 shrink-0 font-bold">&bull;</span>
                        <span>{highlight}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </div>

            <!-- Footer -->
            <div class="pt-4 border-t border-zinc-100 dark:border-zinc-800/80">
              <div class="flex flex-wrap gap-1.5 mb-4">
                {app.technologies.map((tech) => (
                  <span class="inline-flex items-center rounded-md px-2 py-0.5 text-[11px] font-medium bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 border border-zinc-200/60 dark:border-zinc-700/60">
                    {tech}
                  </span>
                ))}
              </div>

              <div class="flex items-center justify-between">
                <a
                  href={app.playStoreUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 rounded-xl bg-zinc-900 text-white dark:bg-zinc-100 dark:text-zinc-900 px-4 py-2 text-xs font-semibold hover:bg-purple-600 dark:hover:bg-purple-500 dark:hover:text-white transition-all shadow-xs group/link"
                  aria-label={`View ${app.name} on Google Play Store`}
                >
                  <svg class="h-3.5 w-3.5 text-emerald-400 shrink-0" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M3.609 1.814L13.792 12 3.61 22.186c-.37-.34-.61-.83-.61-1.39V3.204c0-.56.24-1.05.61-1.39zm11.597 11.599L4.992 23.63c.27.13.57.2.89.2.47 0 .93-.15 1.32-.43l10.8-6.19-2.796-3.797zm2.796-2.825l3.52 2.02c1.07.61 1.07 1.62 0 2.23l-3.52 2.02-2.3-3.13 2.3-3.14zm-2.796-2.825L7.202.57C6.81.29 6.35.14 5.88.14c-.32 0-.62.07-.89.2l10.214 10.217 2.796-3.797z" />
                  </svg>
                  <span>View on Google Play</span>
                  <svg class="h-3 w-3 transition-transform group-hover/link:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                </a>
              </div>
            </div>
          </article>
        </div>
      ))}
    </div>

    <!-- Empty State -->
    <div id="parallax-empty-state" class="hidden rounded-2xl border border-dashed border-zinc-300 dark:border-zinc-700 p-12 text-center mt-6">
      <p class="text-sm font-semibold text-zinc-900 dark:text-zinc-100">No applications match your filter</p>
    </div>
  </div>
</section>

<script>
  // 3D Perspective Tilt on Mouse Movement
  function initCardTilt() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const cards = document.querySelectorAll<HTMLElement>('.parallax-app-card');

    cards.forEach((card) => {
      card.addEventListener('mousemove', (e) => {
        const rect = card.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        const centerX = rect.width / 2;
        const centerY = rect.height / 2;

        const rotateX = ((y - centerY) / centerY) * -6; // max 6 deg
        const rotateY = ((x - centerX) / centerX) * 6;  // max 6 deg

        card.style.transform = `perspective(1000px) rotateX(${rotateX.toFixed(2)}deg) rotateY(${rotateY.toFixed(2)}deg) translateY(-4px)`;
      });

      card.addEventListener('mouseleave', () => {
        card.style.transform = 'perspective(1000px) rotateX(0deg) rotateY(0deg) translateY(0px)';
      });
    });
  }

  // Filter interactivity for Parallax theme
  function initParallaxFilters() {
    const searchInput = document.getElementById('parallax-search-input') as HTMLInputElement | null;
    const domainSelect = document.getElementById('parallax-domain-filter') as HTMLSelectElement | null;
    const modelSelect = document.getElementById('parallax-model-filter') as HTMLSelectElement | null;
    const resetBtn = document.getElementById('parallax-reset-btn');
    const resultsCount = document.getElementById('parallax-results-count');
    const emptyState = document.getElementById('parallax-empty-state');
    const cardWrappers = document.querySelectorAll<HTMLElement>('.tilt-wrapper');
    const total = cardWrappers.length;

    function filter() {
      const q = (searchInput?.value || '').trim().toLowerCase();
      const d = domainSelect?.value || 'all';
      const m = modelSelect?.value || 'all';

      const isFiltered = q.length > 0 || d !== 'all' || m !== 'all';
      if (resetBtn) {
        if (isFiltered) resetBtn.classList.remove('hidden');
        else resetBtn.classList.add('hidden');
      }

      let count = 0;
      cardWrappers.forEach((wrapper) => {
        const card = wrapper.querySelector<HTMLElement>('.parallax-app-card');
        if (!card) return;

        const name = card.dataset.name || '';
        const domain = card.dataset.domain || '';
        const model = card.dataset.model || '';
        const tech = card.dataset.tech || '';

        const matchQ = q === '' || name.includes(q) || tech.includes(q);
        const matchD = d === 'all' || domain === d;
        const matchM = m === 'all' || model === m;

        if (matchQ && matchD && matchM) {
          wrapper.classList.remove('hidden');
          count++;
        } else {
          wrapper.classList.add('hidden');
        }
      });

      if (resultsCount) resultsCount.textContent = `Showing ${count} of ${total} applications`;
      if (emptyState) {
        if (count === 0) emptyState.classList.remove('hidden');
        else emptyState.classList.add('hidden');
      }
    }

    searchInput?.addEventListener('input', filter);
    domainSelect?.addEventListener('change', filter);
    modelSelect?.addEventListener('change', filter);
    resetBtn?.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      if (domainSelect) domainSelect.value = 'all';
      if (modelSelect) modelSelect.value = 'all';
      filter();
    });
  }

  initCardTilt();
  initParallaxFilters();
</script>
