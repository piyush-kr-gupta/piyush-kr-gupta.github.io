---
import { portfolioData } from '../../../data/portfolio';
import { getAssetUrl } from '../../../utils/url';

const { profile, contact, resume } = portfolioData;
---

<section id="top" class="relative pt-12 pb-20 md:pt-20 md:pb-28 border-b border-zinc-800/80 bg-zinc-950 text-zinc-100 overflow-hidden">
  <!-- Subtle dark craft grid background -->
  <div class="pointer-events-none absolute inset-0 bg-[linear-gradient(to_right,#1f293715_1px,transparent_1px),linear-gradient(to_bottom,#1f293715_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)]"></div>

  <!-- Radial ambient spotlight -->
  <div class="pointer-events-none absolute -top-40 left-1/2 -translate-x-1/2 h-96 w-[48rem] rounded-full bg-sky-500/10 blur-[128px]"></div>

  <div class="relative mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl">
      
      <!-- Live Status Pill with Monospace Badge -->
      <div class="inline-flex items-center gap-2.5 rounded-full border border-zinc-800 bg-zinc-900/90 px-3.5 py-1 text-xs font-mono text-zinc-300 mb-6 shadow-xs backdrop-blur-md">
        <span class="relative flex h-2 w-2">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500"></span>
        </span>
        <span>{profile.location}</span>
        <span class="text-zinc-600">&bull;</span>
        <span class="text-emerald-400">AVAILABLE FOR SENIOR ROLES</span>
      </div>

      <!-- Headline -->
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black tracking-tight text-white leading-[1.1]">
        {profile.name}
      </h1>

      <p class="mt-3 text-xl sm:text-2xl font-mono font-medium text-sky-400 tracking-tight">
        {profile.headline}
      </p>

      <p class="mt-5 text-base sm:text-lg text-zinc-400 leading-relaxed max-w-2xl font-sans">
        {profile.shortSummary}
      </p>

      <!-- Command Palette Quick Launcher Bar -->
      <div class="mt-6 inline-flex items-center gap-3 rounded-xl border border-zinc-800 bg-zinc-900/80 px-4 py-2 text-xs font-mono text-zinc-400 shadow-inner">
        <span class="inline-flex items-center gap-1 text-zinc-300 font-semibold">
          <kbd class="rounded border border-zinc-700 bg-zinc-800 px-1.5 py-0.5 text-[10px] text-zinc-200">⌘K</kbd>
          <span>Command Menu</span>
        </span>
        <span class="text-zinc-600">|</span>
        <span class="text-zinc-500">Quick-jump to projects, domains & resume</span>
        <button
          type="button"
          id="craft-hero-cmd-btn"
          class="ml-2 rounded-md bg-zinc-800 px-2 py-0.5 text-[11px] font-sans font-medium text-sky-400 hover:text-sky-300 hover:bg-zinc-700 transition-colors"
        >
          Open
        </button>
      </div>

      <!-- Linear Monospace Metric Strip -->
      <div class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-3 py-4 border-y border-zinc-800/80 font-mono">
        <div>
          <span class="block text-2xl font-black tracking-tight text-white">{profile.experienceYears}</span>
          <span class="text-[11px] text-zinc-500 uppercase tracking-wider">Years Exp</span>
        </div>
        <div>
          <span class="block text-2xl font-black tracking-tight text-sky-400">25M+</span>
          <span class="text-[11px] text-zinc-500 uppercase tracking-wider">Installs Reached</span>
        </div>
        <div>
          <span class="block text-2xl font-black tracking-tight text-white">{portfolioData.applications.length} APPS</span>
          <span class="text-[11px] text-zinc-500 uppercase tracking-wider">On Google Play</span>
        </div>
        <div>
          <span class="block text-2xl font-black tracking-tight text-emerald-400">1.5%</span>
          <span class="text-[11px] text-zinc-500 uppercase tracking-wider">Crash Rate Target</span>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="mt-8 flex flex-wrap items-center gap-3.5">
        <a
          href="#work"
          class="inline-flex items-center justify-center rounded-xl bg-white text-zinc-950 px-5 py-2.5 text-xs sm:text-sm font-semibold hover:bg-zinc-200 transition-all shadow-md focus-visible:ring-2 focus-visible:ring-sky-500 group"
        >
          <span>Explore Projects</span>
          <svg class="ml-1.5 h-4 w-4 transition-transform group-hover:translate-y-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
          </svg>
        </a>

        {resume.available && (
          <a
            href={getAssetUrl(resume.downloadPath)}
            download={resume.downloadFilename}
            class="inline-flex items-center justify-center rounded-xl border border-zinc-700 bg-zinc-900/80 px-4 py-2.5 text-xs sm:text-sm font-semibold text-zinc-200 hover:border-sky-500 hover:text-white transition-colors shadow-xs focus-visible:ring-2 focus-visible:ring-sky-500"
          >
            <svg class="mr-1.5 h-4 w-4 text-zinc-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
            </svg>
            <span>{resume.label}</span>
          </a>
        )}

        <!-- Social Buttons -->
        <div class="flex items-center gap-2 ml-auto">
          {contact.email && (
            <a
              href={`mailto:${contact.email}`}
              class="inline-flex h-9 w-9 items-center justify-center rounded-xl border border-zinc-800 bg-zinc-900 text-zinc-400 hover:text-white hover:border-zinc-600 transition-colors"
              aria-label={`Email ${contact.email}`}
              title="Send Email"
            >
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </a>
          )}
          {contact.linkedin && (
            <a
              href={contact.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex h-9 w-9 items-center justify-center rounded-xl border border-zinc-800 bg-zinc-900 text-zinc-400 hover:text-white hover:border-zinc-600 transition-colors"
              aria-label="LinkedIn Profile"
              title="LinkedIn"
            >
              <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24">
                <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
              </svg>
            </a>
          )}
          {contact.github && (
            <a
              href={contact.github}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex h-9 w-9 items-center justify-center rounded-xl border border-zinc-800 bg-zinc-900 text-zinc-400 hover:text-white hover:border-zinc-600 transition-colors"
              aria-label="GitHub Profile"
              title="GitHub"
            >
              <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
              </svg>
            </a>
          )}
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  // Connect quick command button in hero to the Command Palette
  const heroCmdBtn = document.getElementById('craft-hero-cmd-btn');
  heroCmdBtn?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('toggle-command-palette'));
  });
</script>
