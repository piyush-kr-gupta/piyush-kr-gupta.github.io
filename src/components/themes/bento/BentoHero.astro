---
import { portfolioData } from '../../../data/portfolio';
import { getAssetUrl } from '../../../utils/url';

const { profile, contact, resume } = portfolioData;
---

<section id="top" class="pt-8 pb-16 md:pt-14 md:pb-20 border-b border-zinc-200 dark:border-zinc-800/80">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    
    <!-- Bento Hero Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-5">
      
      <!-- Bento Cell 1: Main Introduction (Spans 2 cols on md, 2 cols on lg, row-span-2) -->
      <div class="md:col-span-2 lg:col-span-2 rounded-3xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/90 p-6 sm:p-8 flex flex-col justify-between shadow-xs relative overflow-hidden group">
        <!-- Subtle background accent glow -->
        <div class="pointer-events-none absolute -right-16 -top-16 h-64 w-64 rounded-full bg-sky-500/10 blur-3xl transition-opacity duration-500 group-hover:bg-sky-500/15"></div>

        <div>
          <!-- Live Status Pill -->
          <div class="inline-flex items-center gap-2 rounded-full border border-emerald-200 dark:border-emerald-800/80 bg-emerald-50 dark:bg-emerald-950/40 px-3 py-1 text-xs font-semibold text-emerald-800 dark:text-emerald-300 mb-6">
            <span class="relative flex h-2 w-2">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
              <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500"></span>
            </span>
            <span>{profile.location} &bull; Senior Mobile Engineer</span>
          </div>

          <!-- Name & Title -->
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-zinc-900 dark:text-white leading-[1.15]">
            {profile.name}
          </h1>

          <p class="mt-2.5 text-lg sm:text-xl font-bold bg-gradient-to-r from-sky-600 to-indigo-600 bg-clip-text text-transparent dark:from-sky-400 dark:to-indigo-400">
            {profile.headline}
          </p>

          <p class="mt-4 text-sm sm:text-base text-zinc-600 dark:text-zinc-300 leading-relaxed max-w-xl">
            {profile.shortSummary}
          </p>
        </div>

        <!-- Action CTAs & Socials -->
        <div class="mt-8 pt-6 border-t border-zinc-100 dark:border-zinc-800/80 flex flex-wrap items-center gap-3">
          <a
            href="#work"
            class="inline-flex items-center justify-center rounded-xl bg-zinc-900 text-white dark:bg-white dark:text-zinc-900 px-5 py-2.5 text-xs sm:text-sm font-semibold hover:bg-zinc-800 dark:hover:bg-zinc-100 transition-all shadow-xs focus-visible:ring-2 focus-visible:ring-sky-500"
          >
            <span>Explore Applications</span>
            <svg class="ml-1.5 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
            </svg>
          </a>

          {resume.available && (
            <a
              href={getAssetUrl(resume.downloadPath)}
              download={resume.downloadFilename}
              class="inline-flex items-center justify-center rounded-xl border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-800/80 px-4 py-2.5 text-xs sm:text-sm font-semibold text-zinc-800 dark:text-zinc-200 hover:border-sky-500 hover:text-sky-600 dark:hover:text-sky-400 transition-colors shadow-xs focus-visible:ring-2 focus-visible:ring-sky-500"
            >
              <svg class="mr-1.5 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
              </svg>
              <span>{resume.label}</span>
            </a>
          )}

          <!-- Quick Socials -->
          <div class="flex items-center gap-1.5 ml-auto">
            {contact.email && (
              <a
                href={`mailto:${contact.email}`}
                class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-zinc-200 dark:border-zinc-800 text-zinc-600 dark:text-zinc-400 hover:text-sky-600 dark:hover:text-sky-400 hover:border-sky-500 transition-colors"
                aria-label={`Email ${contact.email}`}
                title="Email"
              >
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </a>
            )}
            {contact.linkedin && (
              <a
                href={contact.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-zinc-200 dark:border-zinc-800 text-zinc-600 dark:text-zinc-400 hover:text-sky-600 dark:hover:text-sky-400 hover:border-sky-500 transition-colors"
                aria-label="LinkedIn Profile"
                title="LinkedIn"
              >
                <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24">
                  <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
                </svg>
              </a>
            )}
            {contact.github && (
              <a
                href={contact.github}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-zinc-200 dark:border-zinc-800 text-zinc-600 dark:text-zinc-400 hover:text-sky-600 dark:hover:text-sky-400 hover:border-sky-500 transition-colors"
                aria-label="GitHub Profile"
                title="GitHub"
              >
                <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24">
                  <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
                </svg>
              </a>
            )}
          </div>
        </div>
      </div>

      <!-- Bento Cell 2: Scale Stat -->
      <div class="rounded-3xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/90 p-6 flex flex-col justify-between shadow-xs">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold uppercase tracking-wider text-sky-600 dark:text-sky-400">Scale Impact</span>
          <span class="inline-flex h-8 w-8 items-center justify-center rounded-xl bg-sky-50 dark:bg-sky-950/60 text-sky-600 dark:text-sky-400">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
            </svg>
          </span>
        </div>
        <div class="mt-6">
          <span class="block text-4xl sm:text-5xl font-black tracking-tight text-zinc-900 dark:text-white">
            120M+
          </span>
          <span class="block text-sm font-bold text-zinc-800 dark:text-zinc-200 mt-1">Google Play Downloads</span>
          <p class="mt-1 text-xs text-zinc-500 dark:text-zinc-400 leading-snug">
            Led by BigBasket (100M+), OTT Watch (10M+), Vahak (5M+), and MyMandir (5M+).
          </p>
        </div>
      </div>

      <!-- Bento Cell 3: Experience Stat -->
      <div class="rounded-3xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/90 p-6 flex flex-col justify-between shadow-xs">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold uppercase tracking-wider text-indigo-600 dark:text-indigo-400">Experience</span>
          <span class="inline-flex h-8 w-8 items-center justify-center rounded-xl bg-indigo-50 dark:bg-indigo-950/60 text-indigo-600 dark:text-indigo-400">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </span>
        </div>
        <div class="mt-6">
          <span class="block text-4xl sm:text-5xl font-black tracking-tight text-zinc-900 dark:text-white">
            {profile.experienceYears}
          </span>
          <span class="block text-sm font-bold text-zinc-800 dark:text-zinc-200 mt-1">Mobile Engineering</span>
          <p class="mt-1 text-xs text-zinc-500 dark:text-zinc-400 leading-snug">
            Native Android (Kotlin/Java) & Cross-Platform Flutter with Clean Architecture.
          </p>
        </div>
      </div>

      <!-- Bento Cell 4: Production Apps Built -->
      <div class="rounded-3xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/90 p-6 flex flex-col justify-between shadow-xs">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold uppercase tracking-wider text-emerald-600 dark:text-emerald-400">Portfolio</span>
          <span class="inline-flex h-8 w-8 items-center justify-center rounded-xl bg-emerald-50 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
            </svg>
          </span>
        </div>
        <div class="mt-6">
          <span class="block text-4xl sm:text-5xl font-black tracking-tight text-zinc-900 dark:text-white">
            {portfolioData.applications.length} Apps
          </span>
          <span class="block text-sm font-bold text-zinc-800 dark:text-zinc-200 mt-1">Live on Google Play</span>
          <p class="mt-1 text-xs text-zinc-500 dark:text-zinc-400 leading-snug">
            Proven track record spanning Quick Commerce, Logistics, Healthcare, & Media.
          </p>
        </div>
      </div>

      <!-- Bento Cell 5: Architecture & Quality Benchmarks (Spans 1 col on md, 1 col on lg) -->
      <div class="rounded-3xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/90 p-6 flex flex-col justify-between shadow-xs">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold uppercase tracking-wider text-amber-600 dark:text-amber-400">Quality Benchmark</span>
          <span class="inline-flex h-8 w-8 items-center justify-center rounded-xl bg-amber-50 dark:bg-amber-950/60 text-amber-600 dark:text-amber-400">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </span>
        </div>
        <div class="mt-6">
          <span class="block text-3xl sm:text-4xl font-black tracking-tight text-zinc-900 dark:text-white">
            8% &rarr; 1.5%
          </span>
          <span class="block text-sm font-bold text-zinc-800 dark:text-zinc-200 mt-1">Crash Rate Reduction</span>
          <p class="mt-1 text-xs text-zinc-500 dark:text-zinc-400 leading-snug">
            Achieved at CrelioHealth via reactive architectures, strict error handling, and Room migrations.
          </p>
        </div>
      </div>

      <!-- Bento Cell 6: Engineering Pillars & Core Tech Strip (Spans full width or 2 cols) -->
      <div class="md:col-span-3 lg:col-span-2 rounded-3xl border border-zinc-200 dark:border-zinc-800 bg-gradient-to-br from-zinc-50 to-zinc-100/60 dark:from-zinc-900 dark:to-zinc-900/60 p-6 flex flex-col justify-between shadow-xs">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-zinc-500 dark:text-zinc-400">Core Engineering Stack</span>
          <h2 class="mt-1 text-base font-bold text-zinc-900 dark:text-zinc-100">
            Clean Architecture & Reliable Concurrency
          </h2>
          <p class="mt-1 text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed">
            Multi-module architecture, unidirectional data flow (MVI/MVVM/BLoC), offline-first caching, and background geofencing synchronization.
          </p>
        </div>

        <div class="mt-4 flex flex-wrap gap-1.5">
          {['Kotlin', 'Flutter', 'Jetpack Compose', 'Coroutines & Flow', 'Clean Architecture', 'Hilt / Dagger', 'Room DB', 'BLoC', 'WorkManager'].map((tag) => (
            <span class="inline-flex items-center rounded-lg border border-zinc-200 dark:border-zinc-700/80 bg-white dark:bg-zinc-800 px-2.5 py-1 text-xs font-medium text-zinc-800 dark:text-zinc-200 shadow-2xs">
              {tag}
            </span>
          ))}
        </div>
      </div>

    </div>

  </div>
</section>
