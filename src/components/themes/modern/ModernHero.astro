---
import { portfolioData } from '../../../data/portfolio';
import { getAssetUrl } from '../../../utils/url';

const { profile, contact, resume } = portfolioData;
---

<section id="top" class="relative pt-10 pb-10 md:pt-16 md:pb-14 overflow-hidden">
  <!-- Subtle ambient modern background glow -->
  <div class="pointer-events-none absolute inset-x-0 -top-40 -z-10 transform-gpu overflow-hidden blur-3xl sm:-top-80" aria-hidden="true">
    <div class="relative left-[calc(50%-11rem)] aspect-1155/678 w-[36.125rem] -translate-x-1/2 rotate-[30deg] bg-gradient-to-tr from-sky-400/20 to-indigo-500/20 dark:from-sky-500/10 dark:to-indigo-500/15 opacity-70 sm:left-[calc(50%-20rem)] sm:w-[72.1875rem]"></div>
  </div>

  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl">
      <!-- Live Status Pill -->
      <div class="inline-flex items-center gap-2 rounded-full border border-sky-200/80 dark:border-sky-800/80 bg-sky-50/80 dark:bg-sky-950/50 backdrop-blur-md px-3.5 py-1 text-xs font-medium text-sky-800 dark:text-sky-300 mb-6 shadow-xs">
        <span class="relative flex h-2 w-2">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500"></span>
        </span>
        <span>{profile.location} &bull; Open to Senior Mobile & Lead Roles</span>
      </div>

      <!-- Main Headline with subtle gradient accent -->
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-zinc-900 dark:text-white leading-[1.1]">
        Hi, I'm <span class="bg-gradient-to-r from-sky-600 to-indigo-600 bg-clip-text text-transparent dark:from-sky-400 dark:to-indigo-400">{profile.name}</span>
      </h1>

      <p class="mt-3 text-xl sm:text-2xl font-semibold text-zinc-700 dark:text-zinc-200">
        {profile.headline}
      </p>

      <!-- Concise introduction -->
      <p class="mt-5 text-base sm:text-lg text-zinc-600 dark:text-zinc-300 leading-relaxed max-w-2xl">
        {profile.shortSummary}
      </p>

      <!-- Metric Highlights Strip -->
      <div class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-3 py-4 border-y border-zinc-200/80 dark:border-zinc-800/80">
        <div>
          <span class="block text-2xl font-bold tracking-tight text-sky-600 dark:text-sky-400">{profile.experienceYears}</span>
          <span class="text-xs text-zinc-500 dark:text-zinc-400 font-medium">Industry Experience</span>
        </div>
        <div>
          <span class="block text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">{portfolioData.applications.length} Apps</span>
          <span class="text-xs text-zinc-500 dark:text-zinc-400 font-medium">Production Portfolio</span>
        </div>
        <div>
          <span class="block text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">5 Domains</span>
          <span class="text-xs text-zinc-500 dark:text-zinc-400 font-medium">Commerce to Health</span>
        </div>
        <div>
          <span class="block text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">120M+</span>
          <span class="text-xs text-zinc-500 dark:text-zinc-400 font-medium">Installs Reached</span>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="mt-8 flex flex-wrap items-center gap-3.5">
        <a
          href="#work"
          class="inline-flex items-center justify-center rounded-xl bg-gradient-to-r from-sky-600 to-indigo-600 px-6 py-3 text-sm font-semibold text-white hover:from-sky-500 hover:to-indigo-500 transition-all shadow-md hover:shadow-lg focus-visible:ring-2 focus-visible:ring-sky-500 group"
        >
          <span>Explore My Work</span>
          <svg class="ml-2 h-4 w-4 transition-transform group-hover:translate-y-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
          </svg>
        </a>

        {resume.available && (
          <a
            href={getAssetUrl(resume.downloadPath)}
            download={resume.downloadFilename}
            class="inline-flex items-center justify-center rounded-xl border border-zinc-300 dark:border-zinc-700 bg-white/80 dark:bg-zinc-900/80 backdrop-blur-md px-5 py-3 text-sm font-semibold text-zinc-800 dark:text-zinc-200 hover:border-sky-500 dark:hover:border-sky-400 hover:text-sky-600 dark:hover:text-sky-400 transition-all shadow-xs focus-visible:ring-2 focus-visible:ring-sky-500"
          >
            <svg class="mr-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
            </svg>
            <span>{resume.label}</span>
          </a>
        )}

        <!-- Social Icons -->
        <div class="flex items-center gap-2 pl-2">
          {contact.email && (
            <a
              href={`mailto:${contact.email}`}
              class="inline-flex h-11 w-11 items-center justify-center rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white/80 dark:bg-zinc-900/80 backdrop-blur-md text-zinc-600 dark:text-zinc-400 hover:text-sky-600 dark:hover:text-sky-400 hover:border-sky-500 transition-colors"
              aria-label={`Send email to ${contact.email}`}
              title="Send Email"
            >
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </a>
          )}

          {contact.linkedin && (
            <a
              href={contact.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex h-11 w-11 items-center justify-center rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white/80 dark:bg-zinc-900/80 backdrop-blur-md text-zinc-600 dark:text-zinc-400 hover:text-sky-600 dark:hover:text-sky-400 hover:border-sky-500 transition-colors"
              aria-label="LinkedIn Profile"
              title="LinkedIn Profile"
            >
              <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24">
                <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
              </svg>
            </a>
          )}

          {contact.github && (
            <a
              href={contact.github}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex h-11 w-11 items-center justify-center rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white/80 dark:bg-zinc-900/80 backdrop-blur-md text-zinc-600 dark:text-zinc-400 hover:text-sky-600 dark:hover:text-sky-400 hover:border-sky-500 transition-colors"
              aria-label="GitHub Profile"
              title="GitHub Profile"
            >
              <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
              </svg>
            </a>
          )}
        </div>
      </div>
    </div>
  </div>
</section>
