---
import { portfolioData } from '../data/portfolio';

const { profile } = portfolioData;
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-zinc-200/80 dark:border-zinc-800/80 bg-white dark:bg-zinc-950 py-12 transition-colors">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-zinc-500 dark:text-zinc-400">
      <div>
        <p class="font-medium text-zinc-700 dark:text-zinc-300">
          &copy; {currentYear} {profile.name}
        </p>
        <p class="mt-0.5">
          {profile.headline}
        </p>
      </div>

      <div class="flex items-center gap-6">
        <a
          href="#top"
          class="inline-flex items-center gap-1 font-medium text-sky-600 dark:text-sky-400 hover:text-sky-700 dark:hover:text-sky-300 transition-colors focus-visible:ring-2 focus-visible:ring-sky-500 rounded p-1 -m-1"
          aria-label="Back to top of the page"
        >
          <span>Back to top</span>
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 10l7-7m0 0l7 7m-7-7v18" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</footer>
