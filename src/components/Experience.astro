---
import { portfolioData } from '../data/portfolio';
import { getAssetUrl } from '../utils/url';

const { experiences, resume } = portfolioData;
---

<section id="experience" class="py-16 md:py-24 border-b border-zinc-200/80 dark:border-zinc-800/80 scroll-mt-16">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-14">
      <div class="max-w-2xl">
        <h2 class="text-xs font-semibold uppercase tracking-wider text-sky-600 dark:text-sky-400 mb-2">
          Career History
        </h2>
        <p class="text-3xl sm:text-4xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50">
          Professional Experience
        </p>
        <p class="mt-3 text-base text-zinc-600 dark:text-zinc-400 leading-relaxed">
          6.5+ years of engineering progression building high-concurrency mobile products and modernizing enterprise codebases.
        </p>
      </div>

      {resume.available && (
        <a
          href={getAssetUrl(resume.downloadPath)}
          download={resume.downloadFilename}
          class="inline-flex items-center gap-2 text-xs font-semibold text-sky-600 dark:text-sky-400 hover:text-sky-700 dark:hover:text-sky-300 transition-colors shrink-0"
        >
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
          <span>Download complete resume for full details</span>
        </a>
      )}
    </div>

    <!-- Vertical Timeline -->
    <div class="relative border-l border-zinc-200 dark:border-zinc-800 ml-3 md:ml-4 pl-6 md:pl-8 space-y-12">
      {experiences.map((exp) => (
        <div class="relative group">
          <!-- Timeline Node Dot -->
          <div class="absolute -left-[31px] md:-left-[39px] top-1.5 h-3.5 w-3.5 rounded-full border-2 border-white dark:border-zinc-950 bg-sky-500 ring-4 ring-zinc-100 dark:ring-zinc-900 transition-transform group-hover:scale-125"></div>

          <!-- Role & Company Bar -->
          <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1 mb-2">
            <div>
              <h3 class="text-lg font-bold text-zinc-900 dark:text-zinc-100">
                {exp.role}
              </h3>
              <p class="text-sm font-medium text-sky-600 dark:text-sky-400">
                {exp.company}
                {exp.client && (
                  <span class="text-zinc-500 dark:text-zinc-400 font-normal">
                    &bull; Client: {exp.client}
                  </span>
                )}
              </p>
            </div>
            <div class="text-xs font-medium text-zinc-500 dark:text-zinc-400 sm:text-right shrink-0">
              <span>{exp.period}</span>
              <span class="block text-zinc-400 dark:text-zinc-500">{exp.location}</span>
            </div>
          </div>

          <!-- Summary -->
          <p class="text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed mb-4">
            {exp.summary}
          </p>

          <!-- Selected Engineering Achievements -->
          <ul class="space-y-2 mb-4 text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
            {exp.achievements.map((ach) => (
              <li class="flex items-start gap-2.5">
                <span class="text-sky-500 dark:text-sky-400 mt-1 shrink-0 font-bold">&bull;</span>
                <span>{ach}</span>
              </li>
            ))}
          </ul>

          <!-- Tech stack tags -->
          <div class="flex flex-wrap gap-1.5 pt-2">
            {exp.technologies.map((tech) => (
              <span class="inline-flex items-center rounded bg-zinc-100 dark:bg-zinc-800/60 px-2 py-0.5 text-xs font-medium text-zinc-600 dark:text-zinc-400">
                {tech}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
