---
import { portfolioData } from '../data/portfolio';

const { skillCategories } = portfolioData;
---

<section id="skills" class="py-16 md:py-24 border-b border-zinc-200/80 dark:border-zinc-800/80 scroll-mt-16 bg-zinc-50/50 dark:bg-zinc-950/40">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="max-w-2xl mb-12">
      <h2 class="text-xs font-semibold uppercase tracking-wider text-sky-600 dark:text-sky-400 mb-2">
        Technical Competencies
      </h2>
      <p class="text-3xl sm:text-4xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50">
        Skills & Technologies
      </p>
      <p class="mt-3 text-base text-zinc-600 dark:text-zinc-400 leading-relaxed">
        Production-tested toolset spanning native Android, modern cross-platform Flutter, Clean Architecture, and enterprise platform integrations.
      </p>
    </div>

    <!-- Skills Category Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {skillCategories.map((category) => (
        <div class="rounded-xl border border-zinc-200/90 dark:border-zinc-800 bg-white dark:bg-zinc-900/80 p-6 shadow-xs flex flex-col justify-between">
          <div>
            <!-- Category Header -->
            <div class="flex items-center gap-2.5 mb-4 pb-3 border-b border-zinc-100 dark:border-zinc-800">
              <span class="h-2 w-2 rounded-full bg-sky-500"></span>
              <h3 class="text-sm font-bold tracking-tight text-zinc-900 dark:text-zinc-100">
                {category.title}
              </h3>
            </div>

            <!-- Skills List / Chips -->
            <div class="flex flex-wrap gap-2">
              {category.skills.map((skill) => (
                <span class="inline-flex items-center rounded-lg border border-zinc-200 dark:border-zinc-700/80 bg-zinc-50 dark:bg-zinc-800/70 px-3 py-1 text-xs font-medium text-zinc-800 dark:text-zinc-200 hover:border-sky-400 dark:hover:border-sky-500 hover:text-sky-600 dark:hover:text-sky-400 transition-colors">
                  {skill}
                </span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
