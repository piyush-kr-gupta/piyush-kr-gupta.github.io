---
import { portfolioData, getUniqueDomains } from '../data/portfolio';
import { getAssetUrl } from '../utils/url';

const { applications } = portfolioData;
const uniqueDomains = getUniqueDomains(applications);
---

<section id="work" class="py-16 md:py-24 border-b border-zinc-200/80 dark:border-zinc-800/80 scroll-mt-16">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="max-w-2xl mb-10">
      <h2 class="text-xs font-semibold uppercase tracking-wider text-sky-600 dark:text-sky-400 mb-2">
        Application Portfolio
      </h2>
      <p class="text-3xl sm:text-4xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50">
        Production Mobile Applications
      </p>
      <p class="mt-3 text-base text-zinc-600 dark:text-zinc-400 leading-relaxed">
        Commercial applications I have developed, scaled, and modernized across Quick Commerce, Healthcare, Logistics, and Media.
      </p>
    </div>

    <!-- Discovery & Filter Controls -->
    <div class="mb-8 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50/70 dark:bg-zinc-900/50 p-4 sm:p-5">
      <div class="flex flex-col lg:flex-row gap-4 items-stretch lg:items-center justify-between">
        
        <!-- Search Input -->
        <div class="relative flex-1 min-w-[240px]">
          <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-zinc-400 dark:text-zinc-500">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
          <input
            id="app-search-input"
            type="search"
            placeholder="Search by app name or technology..."
            class="w-full rounded-lg border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-900 pl-9 pr-8 py-2 text-sm text-zinc-900 dark:text-zinc-100 placeholder-zinc-400 focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 focus:outline-none transition-all"
            aria-label="Search applications"
          />
          <button
            id="clear-search-btn"
            type="button"
            class="hidden absolute inset-y-0 right-0 flex items-center pr-2.5 text-zinc-400 hover:text-zinc-600 dark:hover:text-zinc-200"
            aria-label="Clear search input"
          >
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

        <!-- Filter Selects -->
        <div class="flex flex-wrap items-center gap-3">
          <!-- Domain Filter (Dynamically derived from portfolio data) -->
          <div class="flex items-center gap-2">
            <label for="domain-filter" class="text-xs font-medium text-zinc-500 dark:text-zinc-400 whitespace-nowrap">
              Domain:
            </label>
            <select
              id="domain-filter"
              class="rounded-lg border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-900 px-3 py-2 text-xs sm:text-sm font-medium text-zinc-800 dark:text-zinc-200 focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 focus:outline-none transition-all"
            >
              <option value="all">All Domains ({applications.length})</option>
              {uniqueDomains.map((domain) => (
                <option value={domain}>{domain}</option>
              ))}
            </select>
          </div>

          <!-- Business Model Filter -->
          <div class="flex items-center gap-2">
            <label for="model-filter" class="text-xs font-medium text-zinc-500 dark:text-zinc-400 whitespace-nowrap">
              Model:
            </label>
            <select
              id="model-filter"
              class="rounded-lg border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-900 px-3 py-2 text-xs sm:text-sm font-medium text-zinc-800 dark:text-zinc-200 focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 focus:outline-none transition-all"
            >
              <option value="all">All Types</option>
              <option value="B2C">B2C</option>
              <option value="B2B">B2B</option>
            </select>
          </div>

          <!-- Reset All Filters Button -->
          <button
            id="reset-filters-btn"
            type="button"
            class="hidden items-center gap-1.5 rounded-lg border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-900 px-3 py-2 text-xs font-medium text-zinc-600 dark:text-zinc-300 hover:text-sky-600 dark:hover:text-sky-400 hover:border-sky-500 transition-colors"
          >
            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.033 8.033 0 01-15.357-2m15.357 2H15" />
            </svg>
            <span>Reset</span>
          </button>
        </div>
      </div>

      <!-- Result Counter & Active Filter Badge -->
      <div class="mt-4 pt-3 border-t border-zinc-200/80 dark:border-zinc-800/80 flex items-center justify-between text-xs text-zinc-500 dark:text-zinc-400">
        <span id="results-count" aria-live="polite">
          Showing {applications.length} of {applications.length} applications
        </span>
        <div id="active-filter-indicators" class="flex items-center gap-2 flex-wrap"></div>
      </div>
    </div>

    <!-- Applications Grid -->
    <div id="applications-grid" class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {applications.map((app) => (
        <article
          class="app-card group flex flex-col justify-between rounded-xl border border-zinc-200/90 dark:border-zinc-800 bg-white dark:bg-zinc-900/70 p-6 hover:border-zinc-400 dark:hover:border-zinc-700 transition-all hover:shadow-xs"
          data-app-id={app.id}
          data-name={app.name.toLowerCase()}
          data-domain={app.domain}
          data-model={app.businessModel}
          data-tech={app.technologies.join(' ').toLowerCase()}
        >
          <div>
            <!-- Card Header -->
            <div class="flex items-start justify-between gap-4 mb-4">
              <div class="flex items-center gap-3">
                {app.iconPath ? (
                  <div class="relative h-12 w-12 shrink-0 overflow-hidden rounded-xl border border-zinc-200/90 dark:border-zinc-700/80 bg-zinc-100 dark:bg-zinc-800 shadow-xs group-hover:border-sky-500/50 transition-colors">
                    <img
                      src={getAssetUrl(app.iconPath)}
                      alt={`${app.name} icon`}
                      width="48"
                      height="48"
                      loading="lazy"
                      decoding="async"
                      class="h-full w-full object-cover"
                    />
                  </div>
                ) : (
                  <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-zinc-100 dark:bg-zinc-800 font-bold text-sm tracking-tight text-zinc-800 dark:text-zinc-200 border border-zinc-200 dark:border-zinc-700/80 group-hover:border-sky-500/50 group-hover:text-sky-600 dark:group-hover:text-sky-400 transition-colors">
                    {app.initials}
                  </div>
                )}
                <div>
                  <h3 class="text-lg font-bold text-zinc-900 dark:text-zinc-100 group-hover:text-sky-600 dark:group-hover:text-sky-400 transition-colors">
                    {app.name}
                  </h3>
                  {app.company && (
                    <p class="text-xs text-zinc-500 dark:text-zinc-400">
                      {app.company}
                    </p>
                  )}
                </div>
              </div>

              <!-- Domain & Business Model Badges -->
              <div class="flex flex-col items-end gap-1.5 shrink-0">
                <span class="inline-flex items-center rounded-md bg-zinc-100 dark:bg-zinc-800/90 border border-zinc-200 dark:border-zinc-700 px-2 py-0.5 text-xs font-medium text-zinc-700 dark:text-zinc-300">
                  {app.domain}
                </span>
                {app.businessModel !== 'Unspecified' && (
                  <span class="inline-flex items-center rounded-md bg-sky-50 dark:bg-sky-950/40 border border-sky-200 dark:border-sky-800/60 px-2 py-0.5 text-[11px] font-semibold text-sky-700 dark:text-sky-300">
                    {app.businessModel}
                  </span>
                )}
                {app.downloads && (
                  <span class="inline-flex items-center rounded-md bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800/60 px-2 py-0.5 text-[11px] font-bold text-emerald-700 dark:text-emerald-300">
                    {app.downloads}
                  </span>
                )}
              </div>
            </div>

            <!-- Description -->
            <p class="text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed mb-4">
              {app.description}
            </p>

            <!-- Key Contributions / Highlights -->
            {app.highlights && app.highlights.length > 0 && (
              <div class="mb-5 space-y-2">
                <p class="text-xs font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400">
                  Key Engineering Contributions
                </p>
                <ul class="space-y-1.5 text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed">
                  {app.highlights.map((highlight) => (
                    <li class="flex items-start gap-2">
                      <span class="text-sky-500 dark:text-sky-400 mt-1 shrink-0 font-bold">&bull;</span>
                      <span>{highlight}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>

          <!-- Bottom: Technologies & External Link -->
          <div class="pt-4 border-t border-zinc-100 dark:border-zinc-800/80">
            <!-- Tech badges -->
            <div class="flex flex-wrap gap-1.5 mb-4">
              {app.technologies.map((tech) => (
                <span class="inline-flex items-center rounded px-2 py-0.5 text-[11px] font-medium bg-zinc-100 dark:bg-zinc-800/60 text-zinc-600 dark:text-zinc-400">
                  {tech}
                </span>
              ))}
            </div>

            <!-- Action Button -->
            <div class="flex items-center justify-between">
              <a
                href={app.playStoreUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 text-xs font-semibold text-zinc-900 dark:text-zinc-100 hover:text-sky-600 dark:hover:text-sky-400 transition-colors group/link focus-visible:ring-2 focus-visible:ring-sky-500 rounded px-1 -mx-1"
                aria-label={`View ${app.name} on Google Play Store (opens in a new tab)`}
              >
                <!-- Google Play Triangle Icon -->
                <svg class="h-3.5 w-3.5 text-emerald-500 shrink-0" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M3.609 1.814L13.792 12 3.61 22.186c-.37-.34-.61-.83-.61-1.39V3.204c0-.56.24-1.05.61-1.39zm11.597 11.599L4.992 23.63c.27.13.57.2.89.2.47 0 .93-.15 1.32-.43l10.8-6.19-2.796-3.797zm2.796-2.825l3.52 2.02c1.07.61 1.07 1.62 0 2.23l-3.52 2.02-2.3-3.13 2.3-3.14zm-2.796-2.825L7.202.57C6.81.29 6.35.14 5.88.14c-.32 0-.62.07-.89.2l10.214 10.217 2.796-3.797z" />
                </svg>
                <span>View on Google Play</span>
                <svg class="h-3 w-3 transition-transform group-hover/link:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- Empty State -->
    <div
      id="apps-empty-state"
      class="hidden rounded-xl border border-dashed border-zinc-300 dark:border-zinc-700 p-12 text-center"
    >
      <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-zinc-100 dark:bg-zinc-800 text-zinc-400 dark:text-zinc-500 mb-4">
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </div>
      <h3 class="text-base font-semibold text-zinc-900 dark:text-zinc-100">
        No applications match your criteria
      </h3>
      <p class="mt-1 text-sm text-zinc-500 dark:text-zinc-400 max-w-sm mx-auto">
        Try clearing your search term or selecting a different business domain or model.
      </p>
      <div class="mt-6">
        <button
          id="empty-reset-btn"
          type="button"
          class="inline-flex items-center gap-2 rounded-lg bg-zinc-900 text-white dark:bg-zinc-100 dark:text-zinc-900 px-4 py-2 text-sm font-semibold hover:bg-zinc-800 dark:hover:bg-white transition-colors"
        >
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.033 8.033 0 01-15.357-2m15.357 2H15" />
          </svg>
          <span>Reset All Filters</span>
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  // Application Filter & Search Interactivity
  function initAppFilters() {
    const searchInput = document.getElementById('app-search-input') as HTMLInputElement | null;
    const clearSearchBtn = document.getElementById('clear-search-btn');
    const domainFilter = document.getElementById('domain-filter') as HTMLSelectElement | null;
    const modelFilter = document.getElementById('model-filter') as HTMLSelectElement | null;
    const resetBtn = document.getElementById('reset-filters-btn');
    const emptyResetBtn = document.getElementById('empty-reset-btn');
    const resultsCount = document.getElementById('results-count');
    const emptyState = document.getElementById('apps-empty-state');
    const appCards = document.querySelectorAll<HTMLElement>('.app-card');
    const totalApps = appCards.length;

    if (!searchInput || !domainFilter || !modelFilter || !resultsCount || !emptyState) return;

    function applyFilters() {
      const query = (searchInput?.value || '').trim().toLowerCase();
      const selectedDomain = domainFilter?.value || 'all';
      const selectedModel = modelFilter?.value || 'all';

      // Toggle clear search button
      if (clearSearchBtn) {
        if (query.length > 0) {
          clearSearchBtn.classList.remove('hidden');
        } else {
          clearSearchBtn.classList.add('hidden');
        }
      }

      // Show/hide reset button if any filter is active
      const isFiltered = query.length > 0 || selectedDomain !== 'all' || selectedModel !== 'all';
      if (resetBtn) {
        if (isFiltered) {
          resetBtn.classList.remove('hidden');
          resetBtn.classList.add('inline-flex');
        } else {
          resetBtn.classList.add('hidden');
          resetBtn.classList.remove('inline-flex');
        }
      }

      let visibleCount = 0;

      appCards.forEach((card) => {
        const name = card.dataset.name || '';
        const domain = card.dataset.domain || '';
        const model = card.dataset.model || '';
        const tech = card.dataset.tech || '';

        // Query matches name or tech
        const matchesQuery = query === '' || name.includes(query) || tech.includes(query);
        // Domain match
        const matchesDomain = selectedDomain === 'all' || domain === selectedDomain;
        // Model match
        const matchesModel = selectedModel === 'all' || model === selectedModel;

        if (matchesQuery && matchesDomain && matchesModel) {
          card.classList.remove('hidden');
          visibleCount++;
        } else {
          card.classList.add('hidden');
        }
      });

      // Update counter
      if (resultsCount) {
        resultsCount.textContent = `Showing ${visibleCount} of ${totalApps} applications`;
      }

      // Update empty state
      if (emptyState) {
        if (visibleCount === 0) {
          emptyState.classList.remove('hidden');
        } else {
          emptyState.classList.add('hidden');
        }
      }
    }

    function resetAll() {
      if (searchInput) searchInput.value = '';
      if (domainFilter) domainFilter.value = 'all';
      if (modelFilter) modelFilter.value = 'all';
      applyFilters();
      if (searchInput) searchInput.focus();
    }

    // Expose global method so clicking a domain card in the Domain section can activate the filter
    (window as any).filterPortfolioByDomain = function (domainName: string) {
      if (domainFilter) {
        domainFilter.value = domainName;
      }
      if (searchInput) searchInput.value = '';
      if (modelFilter) modelFilter.value = 'all';
      applyFilters();

      const workSection = document.getElementById('work');
      if (workSection) {
        workSection.scrollIntoView({ behavior: 'smooth' });
      }
    };

    searchInput.addEventListener('input', applyFilters);
    domainFilter.addEventListener('change', applyFilters);
    modelFilter.addEventListener('change', applyFilters);
    resetBtn?.addEventListener('click', resetAll);
    emptyResetBtn?.addEventListener('click', resetAll);
    clearSearchBtn?.addEventListener('click', () => {
      if (searchInput) {
        searchInput.value = '';
        applyFilters();
        searchInput.focus();
      }
    });

    // Check if URL has hash with domain query or params
    const hash = window.location.hash;
    if (hash.includes('domain=')) {
      const parts = hash.split('domain=');
      if (parts[1]) {
        const decoded = decodeURIComponent(parts[1]);
        if (domainFilter && Array.from(domainFilter.options).some(o => o.value === decoded)) {
          domainFilter.value = decoded;
          applyFilters();
        }
      }
    }
  }

  initAppFilters();
</script>
