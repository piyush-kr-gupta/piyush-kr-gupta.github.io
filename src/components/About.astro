---
import { portfolioData } from '../data/portfolio';
import { getAssetUrl } from '../utils/url';

const { profile, education, resume } = portfolioData;
---

<section id="about" class="py-16 md:py-24 border-b border-zinc-200/80 dark:border-zinc-800/80 scroll-mt-16">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      
      <!-- Left Column: Professional Narrative -->
      <div class="lg:col-span-7">
        <h2 class="text-xs font-semibold uppercase tracking-wider text-sky-600 dark:text-sky-400 mb-2">
          Engineering Background
        </h2>
        <p class="text-3xl sm:text-4xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50 mb-6">
          About Me
        </p>

        <div class="space-y-4 text-base text-zinc-600 dark:text-zinc-300 leading-relaxed">
          <p>
            I am a Senior Mobile Engineer with over 6.5 years of professional experience architecting, building, and optimizing production mobile applications. My core expertise bridges native Android development using Kotlin and Java with scalable cross-platform solutions in Flutter and Dart.
          </p>
          <p>
            Throughout my career, I have focused on solving real-world engineering challenges at scale: consolidating multi-app commerce platforms, modernizing legacy Android codebases without breaking backward compatibility, reducing application crash rates from 8% down to 1.5%, and designing offline-first architectures for diagnostic laboratories and freight logistics networks.
          </p>
          <p>
            I believe that clean architecture and disciplined state management are essential for sustainable velocity. Whether structuring unidirectional data flows with BLoC and Flow, setting up dependency injection with Hilt, or profiling rendering pipelines to eliminate dropped frames, my priority is shipping maintainable software that delivers reliable user experiences.
          </p>
        </div>

        {resume.available && (
          <div class="mt-8">
            <a
              href={getAssetUrl(resume.downloadPath)}
              download={resume.downloadFilename}
              class="inline-flex items-center gap-2 rounded-lg border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-900 px-4 py-2 text-sm font-semibold text-zinc-900 dark:text-zinc-100 hover:border-sky-500 dark:hover:border-sky-400 hover:text-sky-600 dark:hover:text-sky-400 transition-colors shadow-xs"
            >
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
              </svg>
              <span>Download Complete Resume</span>
            </a>
          </div>
        )}
      </div>

      <!-- Right Column: Quick Facts & Education -->
      <div class="lg:col-span-5 space-y-6">
        
        <!-- Summary Card -->
        <div class="rounded-xl border border-zinc-200/90 dark:border-zinc-800 bg-zinc-50/70 dark:bg-zinc-900/60 p-6">
          <h3 class="text-xs font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400 mb-4">
            At a Glance
          </h3>
          <dl class="space-y-3.5 text-sm">
            <div class="flex items-center justify-between pb-2 border-b border-zinc-200/60 dark:border-zinc-800/60">
              <dt class="text-zinc-500 dark:text-zinc-400">Total Experience</dt>
              <dd class="font-semibold text-zinc-900 dark:text-zinc-100">{profile.experienceYears}</dd>
            </div>
            <div class="flex items-center justify-between pb-2 border-b border-zinc-200/60 dark:border-zinc-800/60">
              <dt class="text-zinc-500 dark:text-zinc-400">Primary Focus</dt>
              <dd class="font-semibold text-zinc-900 dark:text-zinc-100">Android & Flutter</dd>
            </div>
            <div class="flex items-center justify-between pb-2 border-b border-zinc-200/60 dark:border-zinc-800/60">
              <dt class="text-zinc-500 dark:text-zinc-400">Total Scale</dt>
              <dd class="font-semibold text-emerald-600 dark:text-emerald-400">120M+ Installs</dd>
            </div>
            <div class="flex items-center justify-between pb-2 border-b border-zinc-200/60 dark:border-zinc-800/60">
              <dt class="text-zinc-500 dark:text-zinc-400">Current Location</dt>
              <dd class="font-semibold text-zinc-900 dark:text-zinc-100">{profile.location}</dd>
            </div>
            <div class="flex items-center justify-between">
              <dt class="text-zinc-500 dark:text-zinc-400">Core Languages</dt>
              <dd class="font-semibold text-zinc-900 dark:text-zinc-100">Kotlin, Dart, Java, Swift</dd>
            </div>
          </dl>
        </div>

        <!-- Verified Education Card -->
        {education && education.length > 0 && (
          <div class="rounded-xl border border-zinc-200/90 dark:border-zinc-800 bg-white dark:bg-zinc-900/80 p-6">
            <h3 class="text-xs font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400 mb-4">
              Education
            </h3>
            {education.map((edu) => (
              <div>
                <p class="text-sm font-bold text-zinc-900 dark:text-zinc-100">
                  {edu.degree}
                </p>
                <p class="text-xs text-sky-600 dark:text-sky-400 mt-0.5">
                  {edu.institution}
                </p>
                <div class="flex items-center justify-between text-xs text-zinc-500 dark:text-zinc-400 mt-2">
                  <span>{edu.period} &bull; {edu.location}</span>
                  {edu.grade && <span class="font-semibold text-zinc-700 dark:text-zinc-300">{edu.grade}</span>}
                </div>
              </div>
            ))}
          </div>
        )}
      </div>

    </div>
  </div>
</section>
