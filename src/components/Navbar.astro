---
import { portfolioData } from '../data/portfolio';
import { getAssetUrl } from '../utils/url';

const { profile, resume } = portfolioData;

const navLinks = [
  { label: 'Work', href: '#work' },
  { label: 'Domains', href: '#domains' },
  { label: 'Experience', href: '#experience' },
  { label: 'Skills', href: '#skills' },
  { label: 'About', href: '#about' },
  { label: 'Contact', href: '#contact' },
];
---

<header class="sticky top-0 z-40 w-full border-b border-zinc-200/80 bg-white/90 backdrop-blur-md dark:border-zinc-800/80 dark:bg-zinc-950/90 transition-colors">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <!-- Brand -->
    <a href="#top" class="group flex items-center gap-3 text-left focus-visible:ring-2 focus-visible:ring-sky-500 rounded-lg p-1 -m-1">
      <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-zinc-900 text-sm font-semibold tracking-tight text-white dark:bg-zinc-800 dark:text-sky-400 border border-zinc-700/50">
        PG
      </div>
      <div>
        <span class="block text-sm font-semibold tracking-tight text-zinc-900 dark:text-zinc-100 group-hover:text-sky-600 dark:group-hover:text-sky-400 transition-colors">
          {profile.name}
        </span>
        <span class="block text-xs font-normal text-zinc-500 dark:text-zinc-400">
          {profile.headline}
        </span>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden md:flex items-center gap-1 lg:gap-2" aria-label="Main navigation">
      {navLinks.map((link) => (
        <a
          href={link.href}
          data-nav-link={link.href.replace('#', '')}
          class="rounded-md px-3 py-1.5 text-sm font-medium text-zinc-600 hover:text-zinc-900 hover:bg-zinc-100 dark:text-zinc-400 dark:hover:text-zinc-100 dark:hover:bg-zinc-900 transition-colors"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <!-- Desktop Actions (Resume + Theme Toggle) -->
    <div class="hidden md:flex items-center gap-3">
      {resume.available && (
        <a
          href={getAssetUrl(resume.downloadPath)}
          download={resume.downloadFilename}
          class="inline-flex items-center gap-2 rounded-lg border border-zinc-300 dark:border-zinc-700 bg-zinc-50 dark:bg-zinc-900 px-3.5 py-1.5 text-xs font-semibold text-zinc-800 dark:text-zinc-200 hover:border-sky-500 dark:hover:border-sky-400 hover:text-sky-600 dark:hover:text-sky-400 transition-all shadow-xs"
          aria-label={`Download resume PDF: ${resume.downloadFilename}`}
        >
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
          <span>{resume.label}</span>
        </a>
      )}

      <!-- Theme Toggle -->
      <button
        id="theme-toggle-desktop"
        type="button"
        class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors focus-visible:ring-2 focus-visible:ring-sky-500"
        aria-label="Toggle light and dark color theme"
      >
        <!-- Sun icon (shown when dark mode is active) -->
        <svg class="hidden dark:block h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <!-- Moon icon (shown when light mode is active) -->
        <svg class="block dark:hidden h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>
    </div>

    <!-- Mobile Menu Button & Mobile Theme Toggle -->
    <div class="flex items-center gap-2 md:hidden">
      <button
        id="theme-toggle-mobile"
        type="button"
        class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 focus-visible:ring-2 focus-visible:ring-sky-500"
        aria-label="Toggle light and dark color theme"
      >
        <svg class="hidden dark:block h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <svg class="block dark:hidden h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>

      <button
        id="mobile-menu-button"
        type="button"
        class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-800 focus-visible:ring-2 focus-visible:ring-sky-500"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open navigation menu"
      >
        <!-- Menu Icon -->
        <svg id="menu-icon-open" class="block h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <!-- Close Icon -->
        <svg id="menu-icon-close" class="hidden h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Panel -->
  <div
    id="mobile-menu"
    class="hidden md:hidden border-b border-zinc-200 dark:border-zinc-800 bg-white/95 dark:bg-zinc-950/95 backdrop-blur-md px-4 pt-2 pb-6"
  >
    <nav class="flex flex-col space-y-1" aria-label="Mobile navigation">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="mobile-nav-link rounded-lg px-3 py-2 text-base font-medium text-zinc-700 hover:bg-zinc-100 dark:text-zinc-300 dark:hover:bg-zinc-900 transition-colors"
        >
          {link.label}
        </a>
      ))}

      {resume.available && (
        <div class="pt-3 mt-2 border-t border-zinc-100 dark:border-zinc-800">
          <a
            href={getAssetUrl(resume.downloadPath)}
            download={resume.downloadFilename}
            class="flex w-full items-center justify-center gap-2 rounded-lg bg-zinc-900 text-white dark:bg-zinc-100 dark:text-zinc-900 px-4 py-2.5 text-sm font-semibold hover:bg-zinc-800 dark:hover:bg-white transition-colors"
          >
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
            </svg>
            <span>{resume.label}</span>
          </a>
        </div>
      )}
    </nav>
  </div>
</header>

<script>
  // Mobile menu toggle
  const menuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuOpenIcon = document.getElementById('menu-icon-open');
  const menuCloseIcon = document.getElementById('menu-icon-close');
  const mobileLinks = document.querySelectorAll('.mobile-nav-link');

  function toggleMenu(force?: boolean) {
    if (!mobileMenu || !menuButton) return;
    const isExpanded = menuButton.getAttribute('aria-expanded') === 'true';
    const nextState = force !== undefined ? force : !isExpanded;

    menuButton.setAttribute('aria-expanded', String(nextState));
    menuButton.setAttribute('aria-label', nextState ? 'Close navigation menu' : 'Open navigation menu');

    if (nextState) {
      mobileMenu.classList.remove('hidden');
      menuOpenIcon?.classList.add('hidden');
      menuCloseIcon?.classList.remove('hidden');
    } else {
      mobileMenu.classList.add('hidden');
      menuOpenIcon?.classList.remove('hidden');
      menuCloseIcon?.classList.add('hidden');
    }
  }

  menuButton?.addEventListener('click', () => toggleMenu());

  // Close mobile menu on link click
  mobileLinks.forEach((link) => {
    link.addEventListener('click', () => toggleMenu(false));
  });

  // Close mobile menu on ESC
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menuButton?.getAttribute('aria-expanded') === 'true') {
      toggleMenu(false);
      menuButton.focus();
    }
  });

  // Theme toggle logic (attached to both desktop and mobile buttons)
  function initThemeToggle() {
    const toggles = [
      document.getElementById('theme-toggle-desktop'),
      document.getElementById('theme-toggle-mobile'),
    ];

    toggles.forEach((btn) => {
      btn?.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        try {
          localStorage.setItem('theme', isDark ? 'dark' : 'light');
        } catch {
          // Ignore localStorage errors (e.g. private browsing restrictions)
        }
      });
    });
  }

  // Active navigation highlight on scroll
  function initActiveNavHighlight() {
    const sections = document.querySelectorAll('section[id]');
    const navLinks = document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]');

    if (!('IntersectionObserver' in window)) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const id = entry.target.getAttribute('id');
            navLinks.forEach((link) => {
              const target = link.getAttribute('data-nav-link');
              if (target === id) {
                link.classList.add('text-sky-600', 'dark:text-sky-400', 'font-semibold');
                link.classList.remove('text-zinc-600', 'dark:text-zinc-400');
              } else {
                link.classList.remove('text-sky-600', 'dark:text-sky-400', 'font-semibold');
                link.classList.add('text-zinc-600', 'dark:text-zinc-400');
              }
            });
          }
        });
      },
      { rootMargin: '-20% 0px -70% 0px' }
    );

    sections.forEach((sec) => observer.observe(sec));
  }

  initThemeToggle();
  initActiveNavHighlight();
</script>
